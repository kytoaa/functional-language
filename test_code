head l = case l of
    | x :: xs -> x;
tail l = case l of
    | x :: xs -> xs;

drop n l = case n :: l of
    | 0 :: xs 		 -> xs
    | n :: (x :: xs) -> drop : n - 1 : xs
    | otherwise		 -> ();

foldr f a l = case l of
    | x :: xs	-> f : x : (foldr : f : a : xs)
    | otherwise -> a;

add a b = a + b;
sum = foldr : add : 0;

zipwith f = let
    go a b = case a :: b of
        | () :: _ -> ()
        | _ :: () -> ()
        | (a :: as) :: (b :: bs) -> (f : a : b) :: (go : as : bs);
    in go;

fibs = 0 :: 1 :: (zipwith : add : fibs : (tail : fibs));
fib n = head : (drop : n : fibs);

main = fib : 22;
