main = let
	range n = n :: (range : n + 1);

	head l = case l of
		| x :: xs -> x;
	tail l = case l of
		| x :: xs -> xs;

	take n l = case n :: l of
		| 0 :: rest 	 -> ()
		| n :: (x :: xs) -> x :: (take : n - 1 : xs)
		| otherwise      -> ();
	
	drop n l = case n :: l of
		| 0 :: xs 		 -> xs
		| n :: (x :: xs) -> drop : n - 1 : xs
		| otherwise		 -> ();


	foldr f a l = case l of
		| x :: xs	-> f : x : (foldr : f : a : xs)
		| otherwise -> a;
	
	foldl f a l = case l of
		| x :: xs   -> foldl : f : (f : a : x) : xs
		| otherwise -> a;

	add a b = a + b;
	sum = foldr : add : 0;

	fib n = case n of
		| 0 -> 0
		| 1 -> 1
		| n -> (fib : n - 1) + (fib : n - 2);
	
	zipwith f a b = case a :: b of
		| (a :: as) :: (b :: bs) -> (f : a : b) :: (zipwith : f : as : bs)
		| otherwise				 -> ();
	
	zipWith f = let
		go a b = case a :: b of
			| () :: _ -> ()
			| _ :: () -> ()
			| (x :: xs) :: (y :: ys) -> (f : x : y) :: (go : xs : ys);
		in go;

	fibs = 0 :: 1 :: (zipWith : add : fibs : (tail : fibs));
	fib2 n = head : (drop : n : fibs);

	in fib : 7;
