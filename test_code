head l = case l of
    | x :: xs -> x;
tail l = case l of
    | x :: xs -> xs;

main = let
	drop n l = case n :: l of
		| 0 :: xs 		 -> xs
		| n :: (x :: xs) -> drop : n - 1 : xs
		| otherwise		 -> ();


	foldr f a l = case l of
		| x :: xs	-> f : x : (foldr : f : a : xs)
		| otherwise -> a;
	
	add a b = a + b;
	sum = foldr : add : 0;

	fib n = case n of
		| 0 -> 0
		| 1 -> 1
		| n -> (fib : n - 1) + (fib : n - 2);
	
	zipwith f a b = case a :: b of
		| (a :: as) :: (b :: bs) -> (f : a : b) :: (zipwith : f : as : bs)
		| otherwise				 -> ();
	
	fibs = 0 :: 1 :: (zipwith : add : fibs : (tail : fibs));
	fib2 n = head : (drop : n : fibs);

	in fib2 : 22;
