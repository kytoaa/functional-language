main = let
	range n = n :: (range : n + 1);

	head l = case l of
		| x :: xs -> x;
	tail l = case l of
		| x :: xs -> xs;

	take n l = case n :: l of
		| 0 :: rest 	 -> ()
		| n :: (x :: xs) -> x :: (take : n - 1 : xs)
		| otherwise      -> ();
	
	drop n l = case n :: l of
		| 0 :: xs 		 -> xs
		| n :: (x :: xs) -> drop : n - 1 : xs
		| otherwise		 -> ();


	foldr f a l = case l of
		| x :: xs	-> f : x : (foldr : f : a : xs)
		| otherwise -> a;

	in foldr : (fun x rest -> if x == 3 then true else rest) : false : (range : 0);
