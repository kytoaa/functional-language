mod io = std..io;
use io..monad { `>>=`; `>>`; return };
use io..functor { fmap };
use std { with Some; with None };

main = use io..monad { `>>=`; `>>`; return } in
       use io..applicative { `<*>` } in
       use io..functor { fmap } in
       let `<&>` = std..flip fmap;
    in io..read_line io..stdin <&> (to_num . std..slice..index 0) >>= print_out;

print_out n = case n of
    | Some n -> io..println (n + 1)
    | None   -> io..println (1 + 'a');

to_num c = case c of
    | '0' -> Some 0
    | '1' -> Some 1
    | '2' -> Some 2
    | '3' -> Some 3
    | '4' -> Some 4
    | '5' -> Some 5
    | '6' -> Some 6
    | '7' -> Some 7
    | '8' -> Some 8
    | '9' -> Some 9
    | _   -> None;

