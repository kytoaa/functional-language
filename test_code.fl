mod io = std..io;
mod Option = std..Option;
with Some = std..Some;
with None = std..None;

mod Functor = type {
	with F fmap x;

	fmap f functor = case functor of
		| F fmap x -> F fmap (fmap f x);
	
	inner functor = case functor of
		| F fmap x -> x;
};
fmap = Functor..fmap;

option_functor = Functor..F Option..map;

main = io..println : Option..unwrap_or 0 (Functor..inner (fmap (fun x -> x + 1) (option_functor (Some 3))));

