mod list = std..list;
mod io = std..io;
mod slice = std..slice;

stdin_contents = io..read_line io..stdin;

is_whitespace c = case c of
    | ' '  -> true
    | '\n' -> true
    | '\t' -> true
    | '\r' -> true
    | _    -> false;

trim s = let
    length = slice..len s;
    count_start n = if is_whitespace (slice..index n s) then count_start (n + 1) else n;
    count_end n = if is_whitespace (slice..index n s) then count_start (n - 1) else n;
    in slice..drop (count_start 0) (slice..take (count_end (length - 1) + 1) s);

MyType = @type(MyType);

mod Option = type {
    with Some a;
    with None;

    map f a = case a of
        | Some a -> Some (f a)
        | other  -> other;
};

with Some = Option..Some;
with None = Option..None;

unwrap_or option default = case option of
    | Some a -> a
    | None   -> default;

main = io..println : unwrap_or (Some 5) 0;

