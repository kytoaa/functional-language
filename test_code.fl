mod module_a;

mod module_b = module_a..inner;

mod module_c = {
    a = -6;
};

head l = case l of
    | x :: xs -> x;
tail l = case l of
    | x :: xs -> xs;

foldr f a l = case l of
    | x :: xs	-> f x (foldr f a xs)
    | otherwise -> a;

add a b = a + b;
sum = foldr add 0;

zipwith f = let
    go a b = case a :: b of
        | () :: _ -> ()
        | _ :: () -> ()
        | (a :: as) :: (b :: bs) -> (f a b) :: (go as bs);
    in go;

Some a = true :: a;
None = false :: ();

map f a = case a of
    | true :: a -> Some (f a)
    | false :: _ -> a;

unwrap a = case a of
    | true :: a -> a;

unwrap_or x a = case a of
    | true :: a -> a
    | false :: _ -> x;

flatten a = case a of
    | true :: a -> a
    | false :: _ -> None;

fibs = 0 :: 1 :: (zipwith add fibs (tail fibs));
fib n = head : module_a..drop n fibs;

main = fib 12;

