mod io = std..io;
mod Option = std..Option;
with Some = std..Some;
with None = std..None;

mod Functor = type {
	with F fmap x;

	fmap f functor = case functor of
		| F fmap x -> F fmap (fmap f x);
	
	inner functor = case functor of
		| F fmap x -> x;
};
fmap = Functor..fmap;

mod Monad = type {
	with M bind return x;

	bind f monad = case monad of
		| M bind return x -> M bind return (bind f x);
	
	return monad = case monad of
		| M bind return x -> M bind return (return x);

	inner monad = case monad of
		| M bind return x -> x;
};

flip f a b = f b a;

`>>=` = flip Monad..bind;
`>>` a b = Monad..bind (fun x -> b) a;

option_functor = Functor..F Option..map;
option_monad = Monad..M (fun f x -> Option..join (Option..map f x)) Option..Some;
io_monad = Monad..M (fun f x -> io..join (io..map f x)) io..return;

discard_negative x = if x - 5 < 0 then None else Some x;

main = Monad..inner (io_monad (io..read_line io..stdin) >>= io..print);

